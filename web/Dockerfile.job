# The extraction job: the whole smart-able toolchain (Java 21 for Derby, the
# DuckDB CLI, OpenSSL, unzip, uv) plus this checkout. Run as a Cloud Run Job
# with DATASET_ID set; web/job.py fetches the upload, runs ./smart-able all,
# and publishes the site. Size the job's memory for the in-memory /tmp: a
# 3 GB install zip needs about 16 GiB (zip + unzipped copy + CSV + Parquet +
# decrypted photos); a Conservation Area export needs far less.
FROM eclipse-temurin:21-jdk-noble

ARG DUCKDB_VERSION=v1.1.3
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv curl ca-certificates unzip openssl && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/duckdb_cli-linux-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/aarch64/').zip" -o /tmp/duckdb.zip && \
    unzip -q /tmp/duckdb.zip -d /usr/local/bin && rm /tmp/duckdb.zip && chmod +x /usr/local/bin/duckdb && \
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /app
COPY . .
# Python deps for both the pipeline (timezonefinder) and the job's store client
RUN uv sync --frozen --no-dev --extra web --no-install-project && \
    duckdb -c "INSTALL spatial;" && \
    chmod +x smart-able

ENV PATH="/app/.venv/bin:${PATH}" PYTHONUNBUFFERED=1 JOB_WORK_DIR=/tmp/smart-able
CMD ["python", "web/job.py"]
