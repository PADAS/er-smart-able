# Credentials for SMART's embedded Derby database.
#
# Every SMART Desktop install uses the same fixed administrator credentials.
# They are defined in the SMART source, in the DbUser enum (ADMIN) of
# source/java/org.wcs.smart/src/org/wcs/smart/hibernate/SmartDB.java.
# They are not secret, but are kept out of version control here.
#
# Copy this file to .env and fill in the two values. `./smart-able extract`
# loads .env automatically.
SMART_DB_USER=
SMART_DB_PASSWORD=
