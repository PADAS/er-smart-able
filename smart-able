#!/usr/bin/env bash
# smart-able — Extract, Browse, Export, Load SMART conservation data.
#
#   ./smart-able setup                 check tools, install Python deps (uv), create .env
#   ./smart-able check                 check that the required tools are installed
#   ./smart-able extract <backup>      SMART backup -> work/parquet + decrypted attachments
#   ./smart-able browse                work/parquet -> work/site (browser data)
#   ./smart-able serve [port]          serve the browser on http://localhost:<port> (default 8765)
#   ./smart-able all <backup>          extract + browse
#   ./smart-able clean                 delete the work directory
#
# <backup> can be a SMART Desktop install folder, its data/ folder, a smartdb/
# database folder, a SMART system backup .zip, or a Conservation Area export
# (.zip or unzipped; SMART's File > Export Conservation Area). Outputs go to
# $SMART_ABLE_WORK (default: ./work). See README.md and RUNBOOK.md.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORK=${SMART_ABLE_WORK:-$ROOT/work}

say()  { printf '\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- checks
java_major() {
  java -version 2>&1 | awk -F'"' '/version/ { split($2, v, "."); print (v[1] == "1" ? v[2] : v[1]); exit }'
}

check() {   # $1 = "setup" when called from setup (skip warnings setup is about to fix)
  local ok=1 t
  for t in java duckdb uv openssl unzip od; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  %-8s %s\n' "$t" "$(command -v "$t")"
    else
      printf '  %-8s \033[31mmissing\033[0m\n' "$t"; ok=0
    fi
  done
  # Derby 10.17 (bundled; reads SMART 7.5 and 8.x databases) needs Java 19+
  if command -v java >/dev/null 2>&1 && [ "$(java_major)" -lt 19 ]; then
    warn "Java $(java_major) found; Java 19 or newer is required (21 recommended)"; ok=0
  fi
  ls "$ROOT"/lib/derby/derby-*.jar >/dev/null 2>&1 || { warn "no Derby jars in lib/derby/"; ok=0; }
  if [ "${1:-}" != setup ]; then
    [ -d "$ROOT/.venv" ] || warn "no .venv yet (run ./smart-able setup); timezone inference will be skipped"
    [ -f "$ROOT/.env" ] || warn "no .env yet (run ./smart-able setup, then fill in the credentials)"
  fi
  [ "$ok" = 1 ] || die "missing prerequisites (see RUNBOOK.md, 'Prerequisites')"
  echo "  all required tools found"
}

setup() {
  say "Checking tools"
  check setup
  say "Installing Python dependencies (uv sync -> .venv)"
  # uv reads pyproject.toml + uv.lock, and downloads a Python if none is suitable
  uv sync --project "$ROOT" --quiet
  say "Installing the DuckDB spatial extension"
  duckdb -c "INSTALL spatial;" >/dev/null
  if [ ! -f "$ROOT/.env" ]; then
    cp "$ROOT/.env.example" "$ROOT/.env"
    warn "created .env from .env.example; fill in SMART_DB_USER and SMART_DB_PASSWORD"
  fi
  say "Setup complete"
}

load_env() {
  if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi
  [ -n "${SMART_DB_USER:-}" ] && [ -n "${SMART_DB_PASSWORD:-}" ] ||
    die "SMART_DB_USER / SMART_DB_PASSWORD not set (fill in .env; see .env.example)"
}

# ---------------------------------------------------------------- extract
find_db() {   # first folder under $1 that is a Derby database (service.properties + seg0/)
  local f
  while IFS= read -r -d '' f; do
    if [ -d "$(dirname "$f")/seg0" ]; then dirname "$f"; return 0; fi
  done < <(find "$1" -name service.properties -print0 2>/dev/null)
  return 1
}

find_export() {   # folder under $1 that is a Conservation Area export (conservationarea.dat + database/)
  local f
  f=$(find "$1" -name conservationarea.dat -print -quit 2>/dev/null)
  [ -n "$f" ] && [ -d "$(dirname "$f")/database" ] || return 1
  dirname "$f"
}

extract() {
  local backup=${1:-}
  [ -n "$backup" ] || die "usage: ./smart-able extract <backup>"
  [ -e "$backup" ] || die "not found: $backup"
  mkdir -p "$WORK"

  local src=$backup
  if [ -f "$backup" ]; then
    case $backup in
      *.zip) say "Unzipping backup"
             rm -rf "$WORK/backup"; mkdir -p "$WORK/backup"
             unzip -q "$backup" -d "$WORK/backup"; src=$WORK/backup ;;
      *) die "expected a folder or a .zip: $backup" ;;
    esac
  fi

  local db exp fs input ca_uuid=
  if db=$(find_db "$src"); then
    input=database
    fs=$(find "$src" -type d -name filestore -print -quit 2>/dev/null || true)
    echo "  database:  $db"
    echo "  filestore: ${fs:-(none found; attachments will be skipped)}"
    load_env

    say "Copying the database (the original is never opened)"
    rm -rf "$WORK/smartdb"
    cp -R "$db" "$WORK/smartdb"
    rm -f "$WORK/smartdb"/*.lck

    say "Dumping all SMART tables to CSV"
    rm -rf "$WORK/csv"
    java -Dderby.stream.error.file="$WORK/derby.log" -cp "$ROOT/lib/derby/*" \
      "$ROOT/extract/DumpSmartDb.java" "$WORK/smartdb" "$WORK/csv" | tail -1
  elif exp=$(find_export "$src"); then
    input=export
    # Conservation Area export: the tables are already CSV, so no Java/Derby.
    # conservationarea.dat: line 1 the CA uuid, line 3 its name (CRLF).
    ca_uuid=$(awk 'NR==1 { sub(/\r$/, ""); print }' "$exp/conservationarea.dat")
    [[ $ca_uuid =~ ^[0-9a-f]{32}$ ]] ||
      warn "line 1 of conservationarea.dat is not a conservation area uuid ('$ca_uuid'); attachments will not decrypt"
    [ -d "$exp/filestore" ] && fs=$exp/filestore
    echo "  export:    $exp"
    echo "  conservation area: $(awk 'NR==3 { sub(/\r$/, ""); print }' "$exp/conservationarea.dat") ($ca_uuid)"
    echo "  filestore: ${fs:-(none found; attachments will be skipped)}"

    say "Converting the export's tables to CSV"
    rm -rf "$WORK/smartdb" "$WORK/csv"
    bash "$ROOT/extract/export_to_csv.sh" "$exp" "$WORK/csv" | tail -1
  else
    die "no SMART Derby database (service.properties + seg0/) or Conservation Area export (conservationarea.dat + database/) under: $backup"
  fi

  say "Converting CSV to Parquet"
  rm -rf "$WORK/parquet"
  bash "$ROOT/extract/csv_to_parquet.sh" "$WORK/csv" "$WORK/parquet"
  local ver
  ver=$(duckdb -noheader -list -c "select max(version) from '$WORK/parquet/db_version.parquet' where plugin_id = 'org.wcs.smart'" 2>/dev/null || true)
  echo "  SMART database version: ${ver:-unknown}"

  say "Checking the schema against the known one"
  bash "$ROOT/extract/check_schema.sh" "$WORK/csv" "$input" "${ver:-}"

  if [ -n "$fs" ]; then
    say "Decrypting attachments"
    rm -rf "$WORK/site/attachments"
    bash "$ROOT/extract/decrypt_filestore.sh" "$fs" "$WORK/site/attachments" ${ca_uuid:+"$ca_uuid"}
  fi
  say "Extract complete: $WORK/parquet"
}

# ---------------------------------------------------------------- browse
browse() {
  [ -d "$WORK/parquet" ] || die "no $WORK/parquet; run ./smart-able extract <backup> first"
  say "Building browser data"
  rm -rf "$WORK/site/data"
  mkdir -p "$WORK/site/data"
  local sql=("$ROOT/browse/build_browser_data.sql")
  if [ -f "$WORK/parquet/i_entity.parquet" ]; then
    sql+=("$ROOT/browse/build_profiles.sql")
    echo "  Profiles data found"
  else
    echo "  no Profiles tables; skipping Profiles"
  fi
  (cd "$WORK" && cat "${sql[@]}" | duckdb)

  # Every attachment the database refers to should have come out of the
  # filestore; a backup or export can lack some.
  local att
  att=$(cd "$WORK" && duckdb -noheader -csv -separator ' ' -c "
    WITH ref AS (SELECT p FROM read_json('site/data/*attachments.json', format='array', columns={k: 'VARCHAR', id: 'VARCHAR', p: 'VARCHAR'})),
         have AS (SELECT file FROM glob('site/attachments/**'))
    SELECT count(*), count(*) FILTER (WHERE have.file IS NULL) FROM ref LEFT JOIN have ON have.file = 'site/' || ref.p" 2>/dev/null) || att=
  if [ -z "$att" ]; then
    warn "could not check whether all attachments are present"
  elif [ ! -d "$WORK/site/attachments" ] && [ "${att% *}" -gt 0 ]; then
    warn "the database refers to ${att% *} attachments, but no filestore was extracted (see the extract output); the browser will show them as missing"
  elif [ "${att#* }" -gt 0 ]; then
    warn "${att#* } of ${att% *} attachments the database refers to are not in the backup; the browser will show them as missing"
  else
    echo "  all ${att% *} attachments the database refers to are present"
  fi

  if [ -d "$ROOT/.venv" ]; then
    say "Inferring timezones from GPS"
    uv run --project "$ROOT" --quiet python "$ROOT/browse/infer_timezones.py" "$WORK/site/data"
  else
    warn "no .venv (run ./smart-able setup); timestamps will be shown without a timezone"
  fi

  ln -sfn "$ROOT/browse/index.html" "$WORK/site/index.html"
  say "Browse data ready: $WORK/site  (run ./smart-able serve)"
}

serve() {
  local port=${1:-8765}
  [ -f "$WORK/site/index.html" ] || die "no $WORK/site; run ./smart-able browse first"
  say "Serving http://localhost:$port/  (local machine only; Ctrl-C to stop)"
  # bind to loopback only: the site contains sensitive conservation data
  exec uv run --project "$ROOT" --quiet python -m http.server "$port" --bind 127.0.0.1 --directory "$WORK/site"
}

clean() {
  [ -d "$WORK" ] || { echo "nothing to clean"; return; }
  say "Deleting $WORK"
  rm -rf "$WORK"
}

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }

cmd=${1:-}
shift || true
case $cmd in
  setup)   setup ;;
  check)   check ;;
  extract) extract "$@" ;;
  browse)  browse ;;
  serve)   serve "$@" ;;
  all)     extract "$@"; browse ;;
  clean)   clean ;;
  export|load) die "'$cmd' is not implemented yet (see README.md, Roadmap)" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
